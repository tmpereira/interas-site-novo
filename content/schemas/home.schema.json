{
  "$comment": "Gerado por `npm run schemas` a partir de src/lib/esquemas.ts. Não edite à mão.",
  "title": "content/home.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "hero": {
      "type": "object",
      "properties": {
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "texto": {
          "type": "string"
        },
        "imagem": {
          "type": "string",
          "pattern": "^\\/[^\\s]+$"
        }
      },
      "required": [
        "titulo",
        "texto",
        "imagem"
      ],
      "additionalProperties": {}
    },
    "apresentacao": {
      "type": "string"
    },
    "destaques": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "texto": {
            "type": "string"
          },
          "imagem": {
            "type": "string",
            "pattern": "^\\/[^\\s]+$"
          },
          "posicao_imagem": {
            "type": "string",
            "enum": [
              "esquerda",
              "direita"
            ]
          },
          "botao": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "rotulo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "link": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[/#]"
                      },
                      {
                        "type": "string",
                        "format": "uri"
                      }
                    ]
                  }
                },
                "required": [
                  "rotulo",
                  "link"
                ],
                "additionalProperties": {}
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "titulo",
          "texto",
          "imagem",
          "posicao_imagem",
          "botao"
        ],
        "additionalProperties": {}
      }
    },
    "nota": {
      "type": [
        "string",
        "null"
      ]
    },
    "noticias": {
      "type": "object",
      "properties": {
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "quantidade": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "titulo",
        "quantidade"
      ],
      "additionalProperties": {}
    },
    "publicacoes": {
      "type": "object",
      "properties": {
        "titulo": {
          "type": "string",
          "minLength": 1
        },
        "quantidade": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "titulo",
        "quantidade"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "hero",
    "apresentacao",
    "destaques",
    "nota",
    "noticias",
    "publicacoes"
  ],
  "additionalProperties": {}
}
