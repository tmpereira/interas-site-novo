{
  "$comment": "Gerado por `npm run schemas` a partir de src/lib/esquemas.ts. Não edite à mão.",
  "title": "content/videos.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "videos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "titulo_en": {
            "description": "Tradução em inglês de \"titulo\". Vazio = usa o português.",
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "resumo": {
            "type": [
              "string",
              "null"
            ]
          },
          "resumo_en": {
            "description": "Tradução em inglês de \"resumo\". Vazio = usa o português.",
            "type": [
              "string",
              "null"
            ]
          },
          "capa": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\/[^\\s]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "categorias": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "categorias_en": {
            "description": "Tradução em inglês de \"categorias\": lista do mesmo tamanho e na mesma ordem. Vazia = usa o português.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rotulo": {
                  "type": "string",
                  "minLength": 1
                },
                "rotulo_en": {
                  "description": "Tradução em inglês de \"rotulo\". Vazio = usa o português.",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[/#]"
                    },
                    {
                      "type": "string",
                      "format": "uri"
                    }
                  ]
                }
              },
              "required": [
                "rotulo",
                "url"
              ],
              "additionalProperties": {}
            }
          },
          "conteudo": {
            "type": [
              "string",
              "null"
            ]
          },
          "conteudo_en": {
            "description": "Tradução em inglês de \"conteudo\". Vazio = usa o português.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "slug",
          "titulo",
          "data",
          "resumo",
          "capa",
          "categorias",
          "links",
          "conteudo"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "videos"
  ],
  "additionalProperties": {}
}
