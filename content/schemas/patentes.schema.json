{
  "$comment": "Gerado por `npm run schemas` a partir de src/lib/esquemas.ts. Não edite à mão.",
  "title": "content/patentes.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "patentes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "titulo_en": {
            "description": "Tradução em inglês de \"titulo\". Vazio = usa o português.",
            "type": [
              "string",
              "null"
            ]
          },
          "tipo": {
            "type": "string",
            "enum": [
              "patente",
              "software",
              "marca",
              "modelo-utilidade",
              "outro"
            ]
          },
          "autores": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "numero": {
            "type": [
              "string",
              "null"
            ]
          },
          "orgao": {
            "type": [
              "string",
              "null"
            ]
          },
          "data": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "categorias": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "categorias_en": {
            "description": "Tradução em inglês de \"categorias\": lista do mesmo tamanho e na mesma ordem. Vazia = usa o português.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "pessoas": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "conteudo": {
            "type": [
              "string",
              "null"
            ]
          },
          "conteudo_en": {
            "description": "Tradução em inglês de \"conteudo\". Vazio = usa o português.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "titulo",
          "tipo",
          "autores",
          "numero",
          "orgao",
          "data",
          "categorias",
          "pessoas",
          "conteudo"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "patentes"
  ],
  "additionalProperties": {}
}
