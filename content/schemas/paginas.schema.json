{
  "$comment": "Gerado por `npm run schemas` a partir de src/lib/esquemas.ts. Não edite à mão.",
  "title": "content/paginas.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "paginas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "descricao": {
            "type": [
              "string",
              "null"
            ]
          },
          "conteudo": {
            "type": "string"
          },
          "missao": {
            "type": "object",
            "properties": {
              "sobretitulo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "titulo": {
                "type": "string",
                "minLength": 1
              },
              "texto": {
                "type": "string"
              },
              "etiquetas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "sobretitulo",
              "titulo",
              "texto",
              "etiquetas"
            ],
            "additionalProperties": {}
          },
          "etapas": {
            "type": "object",
            "properties": {
              "sobretitulo": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "titulo": {
                "type": "string",
                "minLength": 1
              },
              "itens": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "titulo": {
                      "type": "string",
                      "minLength": 1
                    },
                    "texto": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "titulo",
                    "texto"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "sobretitulo",
              "titulo",
              "itens"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "slug",
          "titulo",
          "descricao",
          "conteudo"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "paginas"
  ],
  "additionalProperties": {}
}
