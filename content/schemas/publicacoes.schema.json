{
  "$comment": "Gerado por `npm run schemas` a partir de src/lib/esquemas.ts. Não edite à mão.",
  "title": "content/publicacoes.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "publicacoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "artigo",
              "livro",
              "capitulo",
              "trabalho-evento",
              "outro"
            ]
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "autores": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ano": {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          "data": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "periodico": {
            "type": [
              "string",
              "null"
            ]
          },
          "volume": {
            "type": [
              "string",
              "null"
            ]
          },
          "numero": {
            "type": [
              "string",
              "null"
            ]
          },
          "paginas": {
            "type": [
              "string",
              "null"
            ]
          },
          "doi": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^10\\.\\d{4,}\\/\\S+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "resumo": {
            "type": [
              "string",
              "null"
            ]
          },
          "palavras_chave": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pessoas": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "grupos": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "citacoes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "fator_impacto": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "qualis": {
            "type": [
              "string",
              "null"
            ]
          },
          "colaboracao_internacional": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "fonte": {
            "type": "string",
            "minLength": 1
          },
          "preprint": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "materiais": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "tipo",
          "titulo",
          "autores",
          "ano",
          "data",
          "periodico",
          "volume",
          "numero",
          "paginas",
          "doi",
          "url",
          "resumo",
          "palavras_chave",
          "pessoas",
          "grupos",
          "citacoes",
          "fator_impacto",
          "qualis",
          "fonte"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "publicacoes"
  ],
  "additionalProperties": {}
}
